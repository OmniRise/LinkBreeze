# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# AI agent files auto-written by next dev (not part of the project)
/AGENTS.md
/CLAUDE.md

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database
/data/*
!/data/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm
*.db.bak*
*.swp

# auto-generated session secret (from instrumentation.ts)
.secret-key
test-results/

# local-only tooling — ALL project scripts live in /scripts/ (private, not on GitHub)
/scripts/

# demo instance (hosted at linkbreeze-demo.omnirise.dev) — deploy-machine only,
# everything demo-related lives in /data-demo/ (DB, uploads, compose file)
/data-demo/
